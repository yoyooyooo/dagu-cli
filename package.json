{
  "name": "dagu-cli",
  "version": "0.1.1",
  "description": "Named-command client for a Dagu server's REST API. One command per OpenAPI operation.",
  "keywords": ["dagu", "workflow", "cli", "rest", "agent"],
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyooyooo/dagu-cli.git"
  },
  "bugs": "https://github.com/yoyooyooo/dagu-cli/issues",
  "homepage": "https://github.com/yoyooyooo/dagu-cli#readme",
  "type": "module",
  "bin": {
    "dagu-cli": "src/cli.ts"
  },
  "files": [
    "src",
    "spec/openapi.json",
    "spec/commands.json",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dagu-cli": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
